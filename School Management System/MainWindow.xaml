<Window x:Class="School_Management_System.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:School_Management_System"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Margin="20">
        <!-- The button to open the Add form -->
        <Button Content="Open Add Class Form" Height="35" Margin="0,0,0,10" Click="OpenFormButton_Click"/>

        <!-- The new button to fetch data -->
        <Button Content="Show All Class Records" Height="35" Background="#2196F3" Foreground="White" Margin="0,0,0,20" Click="ShowRecordsButton_Click"/>

        <!-- The DataGrid where the database info will appear -->
        <DataGrid x:Name="ClassesDataGrid" Height="200" AutoGenerateColumns="True" IsReadOnly="True" />
    </StackPanel>
</Window>
