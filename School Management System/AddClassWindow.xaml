<Window x:Class="School_Management_System.AddClassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:School_Management_System"
        mc:Ignorable="d"
        Title="AddClassWindow" Height="450" Width="800">
    <StackPanel Margin="20">
        <TextBlock Text="Class Name:" Margin="0,0,0,5" FontWeight="Bold"/>
        <!-- x:Name is how we access this box in C# -->
        <TextBox x:Name="ClassNameTextBox" Height="25" Margin="0,0,0,15"/>

        <TextBlock Text="Room Number:" Margin="0,0,0,5" FontWeight="Bold"/>
        <TextBox x:Name="RoomNumberTextBox" Height="25" Margin="0,0,0,20"/>

        <Button Content="Save Class" Height="35" Background="#4CAF50" Foreground="White" Click="SaveButton_Click"/>
    </StackPanel>
</Window>
