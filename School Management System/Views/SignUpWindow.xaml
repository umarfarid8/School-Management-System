<Window x:Class="School_Management_System.Views.SignUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Account" Height="500" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Border Background="White" CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <StackPanel Margin="30">
            <TextBlock Text="Create Account" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2C3E50" Margin="0,0,0,10"/>
            <TextBlock Text="Join our School Management System" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <TextBlock Text="Full Name" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox x:Name="FullNameTxt" Height="35" Margin="0,0,0,15" VerticalContentAlignment="Center" Padding="5,0,0,0"/>

            <TextBlock Text="Email Address" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox x:Name="EmailTxt" Height="35" Margin="0,0,0,15" VerticalContentAlignment="Center" Padding="5,0,0,0"/>

            <TextBlock Text="Password" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <PasswordBox x:Name="PasswordTxt" Height="35" Margin="0,0,0,25" VerticalContentAlignment="Center" Padding="5,0,0,0"/>

            <Button Content="Register Now" Height="40" Background="#27AE60" Foreground="White" 
                    FontWeight="Bold" Cursor="Hand" Click="Register_Click"/>

            <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center">
                <Run Text="Already have an account?" Foreground="#7F8C8D"/>
                <Hyperlink Click="GoToLogin_Click"> Sign In</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>