<Window x:Class="School_Management_System.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="ClassesDataGrid"
        
        Title="School Admin Dashboard" Height="600" Width="900" WindowStartupLocation="CenterScreen"
        Background="#F4F7F9">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#2C3E50" Grid.Column="0">
            <StackPanel Margin="10">
                <TextBlock Text="SCHOOL ADMIN" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,20,0,40" HorizontalAlignment="Center"/>
                <Button Content="Dashboard" Click="NavDashboard_Click" Style="{StaticResource SidebarButtonStyle}"/>
                <Button Content="Classes" Click="NavClasses_Click" Style="{StaticResource SidebarButtonStyle}"/>
                <Button Content="Students" Click="NavStudents_Click" Style="{StaticResource SidebarButtonStyle}"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Column="1" Background="Transparent" BorderThickness="0" Margin="10">

            <TabItem Header="Students">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66*"/>
                        <ColumnDefinition Width="11*"/>
                        <ColumnDefinition Width="78*"/>
                        <ColumnDefinition Width="501*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,20" Grid.ColumnSpan="4">
                        <Button Content="+ Add New Student" Width="150" Height="35" Background="#27AE60" Foreground="White" Click="OpenAddStudent_Click"/>
                        <Button Content="↻ Refresh List" Width="120" Height="35" Margin="10,0,0,0" Click="RefreshStudents_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="StudentDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                              Background="White" RowHeight="30" AlternatingRowBackground="#F9F9F9" Grid.ColumnSpan="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="*"/>
                            <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </TabItem>


            <TabItem Header="Classes">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="23*"/>
                        <ColumnDefinition Width="633*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,20" Grid.ColumnSpan="2">
                        <Button Content="+ Add New Class" Width="150" Height="35" Background="#2980B9" Foreground="White" Click="OpenAddClass_Click"/>
                        <Button Content="↻ Refresh List" Width="120" Height="35" Margin="10,0,0,0" Click=" ShowRecordsButton_Click "/>

                    </StackPanel>

                    <DataGrid x:Name="ClassesData" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Grid.ColumnSpan="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Class Name" Binding="{Binding ClassName}" Width="*"/>
                            <DataGridTextColumn Header="Room" Binding="{Binding RoomNumber}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>



        </TabControl>
    </Grid>
</Window>