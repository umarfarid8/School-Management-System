<Window x:Class="School_Management_System.Views.AddTeacherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teacher Registration" Height="500" Width="400" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <TextBlock Text="Add/Edit Teacher" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                <TextBlock Text="First Name" Margin="0,5"/>
                <TextBox x:Name="FirstNameTextBox" Height="30" Margin="0,0,0,10"/>

                <TextBlock Text="Last Name" Margin="0,5"/>
                <TextBox x:Name="LastNameTextBox" Height="30" Margin="0,0,0,10"/>

                <TextBlock Text="Email" Margin="0,5"/>
                <TextBox x:Name="EmailTextBox" Height="30" Margin="0,0,0,10"/>

                <TextBlock Text="Phone" Margin="0,5"/>
                <TextBox x:Name="PhoneTextBox" Height="30" Margin="0,0,0,10"/>

                <TextBlock Text="Subject/Specialization" Margin="0,5"/>
                <TextBox x:Name="SubjectTextBox" Height="30" Margin="0,0,0,10"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#F8F9FA" Padding="15" BorderThickness="0,1,0,0" BorderBrush="#DDD">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="CANCEL" Click="Cancel_Click" Margin="0,0,5,0" Height="35"/>
                <Button Content="SAVE TEACHER" Click="Save_Click" Grid.Column="1" Height="35" Background="#27AE60" Foreground="White"/>
            </Grid>
        </Border>
    </Grid>
</Window>