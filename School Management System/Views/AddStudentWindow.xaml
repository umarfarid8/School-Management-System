<Window x:Class="School_Management_System.Views.AddStudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration" Height="450" Width="400" 
        WindowStartupLocation="CenterScreen" Background="#F0F2F5" ResizeMode="NoResize">

    <Border Padding="25" Background="White" Margin="15" CornerRadius="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Add New Student" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

                <!-- First Name -->
                <TextBlock Text="First Name" Foreground="#7F8C8D" Margin="0,5,0,2"/>
                <TextBox x:Name="FirstNameTextBox" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <!-- Last Name -->
                <TextBlock Text="Last Name" Foreground="#7F8C8D" Margin="0,5,0,2"/>
                <TextBox x:Name="LastNameTextBox" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <!-- Email -->
                <TextBlock Text="Email Address" Foreground="#7F8C8D" Margin="0,5,0,2"/>
                <TextBox x:Name="EmailTextBox" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <!-- Phone Number -->
                <TextBlock Text="Phone Number" Foreground="#7F8C8D" Margin="0,5,0,2"/>
                <TextBox x:Name="PhoneTextBox" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,25"/>

                <!-- Action Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="Cancel" Grid.Column="0" Margin="0,0,5,0" Height="35" 
                        Background="#BDC3C7" Foreground="White" BorderThickness="0" Click="CancelButton_Click"/>

                    <Button Content="Save Student" Grid.Column="1" Margin="5,0,0,0" Height="35" 
                        Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="SaveStudent_Click"/>

                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>